{
  "name": "sophia-central-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run copy:zrimo-assets && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/generate-seo-files.mjs",
    "copy:zrimo-assets": "node node_modules/@zrimo/viewer/bin/copy-assets.mjs public/vendor/zrimo",
    "predev": "npm run copy:zrimo-assets"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.16.0",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8",
    "pdfjs-dist": "6.5.438",
    "@zrimo/viewer": "0.1.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
